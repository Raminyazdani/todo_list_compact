{
  "name": "ramin-life-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:domain": "vitest run tests/domain",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env.local scripts/ops/migrate.ts",
    "security:scan": "tsx scripts/ops/public-safety.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "better-auth": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vercel/blob": "2.8.1",
    "drizzle-orm": "0.45.4",
    "pg": "^8.16.3",
    "zod": "^4.3.6",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "@xyflow/react": "^12.10.1",
    "@dagrejs/dagre": "^2.0.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "rrule": "^2.8.1",
    "ical.js": "^2.2.1",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/pg": "^8.16.0",
    "@types/dagre": "^0.7.53",
    "@electric-sql/pglite": "^0.3.15",
    "vitest": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@playwright/test": "^1.58.2",
    "@axe-core/playwright": "^4.11.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0"
  }
}
