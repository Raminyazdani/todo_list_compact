# Production uses an isolated durable PostgreSQL database. Never put secrets in NEXT_PUBLIC_*.
DATABASE_URL=
# Same database, direct endpoint for schema migrations.
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
OWNER_EMAIL=
OWNER_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=
# Existing Blob rows remain readable with their original credential.
# New private uploads and encrypted backups can use Neon Object Storage.
PRIVATE_STORAGE_PROVIDER=neon_object_storage
NEON_STORAGE_ENDPOINT_URL_S3=
NEON_STORAGE_REGION=
NEON_STORAGE_BUCKET=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
# Set only after the private synthetic conditional-PUT probe succeeds.
NEON_STORAGE_IMMUTABLE_PUT_VERIFIED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth Web client callback: {BETTER_AUTH_URL}/api/auth/callback/google
# Owner consents in Settings to calendar.readonly + calendar.events.owned.
TOKEN_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
GOOGLE_ICAL_URL=
GOOGLE_ICAL_ALLOWED_HOSTS=
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_MODEL=
AI_DAILY_BUDGET_USD=1
AI_PRICING_MODEL=
AI_PRICING_VERIFIED_AT=
AI_INPUT_USD_PER_MILLION_TOKENS=
AI_OUTPUT_USD_PER_MILLION_TOKENS=
AI_MAX_CONTEXT_BYTES=24000
AI_MAX_OUTPUT_TOKENS=1200
CRON_SECRET=
